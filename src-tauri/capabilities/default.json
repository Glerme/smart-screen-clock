{
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://api.github.com/repos/Glerme/smart-screen-clock/releases/latest"
        }
      ]
    },
    "autostart:default",
    "notification:default",
    "opener:default"
  ]
}
