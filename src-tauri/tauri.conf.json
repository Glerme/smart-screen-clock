{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartScreen",
  "version": "0.1.0",
  "identifier": "com.gui.smartscreen",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Smart Screen",
        "width": 980,
        "height": 780,
        "visible": false,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
